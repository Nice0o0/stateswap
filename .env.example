# stateswap persona factory — LLM 造数后端配置
#
# 复制为 .env（.env 已在 .gitignore 中，不会被提交）：
#     cp .env.example .env
#     # 然后填上自己的 key
#
# 任何 OpenAI 兼容端点都可以（DeepSeek / GLM / ollama / vllm …）。
STATESWAP_LLM_BASE_URL=https://api.deepseek.com/v1
STATESWAP_LLM_API_KEY=sk-your-key-here
STATESWAP_LLM_MODEL=deepseek-chat
